# Copy to `.env` and uncomment what you need to change. The values shown are the defaults.

# PROJECT_NAME="Data Center Server"
# local | staging | production (docker-compose.yml defaults to production)
# ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO
# API_V1_STR=/api/v1
# Comma-separated origins allowed to call the API from a browser,
# e.g. http://localhost:3000,https://app.example.com
# CORS_ORIGINS=

# Larger requests are rejected with 413. JSON requests (the /unit/*-json endpoints) can be
# a third larger, as they carry the file base64-encoded.
# MAX_UPLOAD_SIZE_MB=200
# Files processed at the same time; extra requests wait for a free slot.
# MAX_CONCURRENT_JOBS=2
# auto | in-memory | streaming | gpu (docker-compose.yml defaults to gpu).
# If the GPU is unusable at startup, the app logs a warning and falls back to CPU.
# POLARS_ENGINE=auto

# --- Docker Compose only ---
# Host port the API is published on.
# APP_PORT=8000
# Uvicorn worker processes. Keep 1 with the GPU engine: each worker holds its own CUDA context.
# WEB_CONCURRENCY=1
